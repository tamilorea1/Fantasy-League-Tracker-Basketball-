generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String?
  password       String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdLeagues League[]       @relation("CreatedLeagues")
  leagueMember   LeagueMember[]
  team           Team[]         @relation("OwnedTeams")
}

model League {
  id           String         @id @default(cuid())
  name         String
  joinCode     String         @unique

  createdAt    DateTime       @default(now())
  creatorId    String
  creator      User           @relation("CreatedLeagues", fields: [creatorId], references: [id])
  leagueMember LeagueMember[]
  team         Team[]
}

model LeagueMember {
  id       String   @id @default(cuid())
  userId   String
  leagueId String
  joinedAt DateTime @default(now())
  role     String   @default("member")
  league   League   @relation(fields: [leagueId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, leagueId], name: "leagueMemberId")
}

model Team {
  id          String   @id @default(cuid())
  teamName    String   @unique
  teamOwnerId String
  leagueId    String
  createdAt   DateTime @default(now())
  league      League   @relation(fields: [leagueId], references: [id])
  user        User     @relation("OwnedTeams", fields: [teamOwnerId], references: [id])

  @@unique([teamOwnerId, leagueId])
}
